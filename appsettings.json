{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AllowedHosts": "*",

  "AppMode": {
    "IsSaaS": false
  },

  "Jwt": {
    "Key": "",
    "Issuer": "LMS_API",
    "Audience": "LMS_CLIENT",
    "DurationInMinutes": 60
  },

  "Resend": {
    "ApiKey": ""
  },

  "EmailSettings": {
    "RetentionDays": 30,
    "MaxRetryAttempts": 3
  },

  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },

  "App": {
    "FrontendUrl": "http://localhost:4200"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://lmsorbit.netlify.app"
    ]
  }
}
